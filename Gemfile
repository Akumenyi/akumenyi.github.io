source "https://rubygems.org"

# GitHub Pages builds this site with its own pinned toolchain. Using the
# `github-pages` gem locally keeps `bundle exec jekyll serve` on exactly the
# same Jekyll, kramdown and plugin versions that production uses.
gem "github-pages", group: :jekyll_plugins
gem "webrick", "~> 1.8"

group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.17"
  gem "jekyll-sitemap", "~> 1.4"
end
